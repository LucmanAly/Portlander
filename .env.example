# Postgres connection string (Supabase: Project Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Market data providers (free tiers) - https://finnhub.io and https://www.alphavantage.co
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=

# Email notifications (free tier: 100/day) - https://resend.com
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL="Portlander <alerts@yourdomain.com>"

# Random secrets you generate yourself, e.g. `openssl rand -hex 32`
CRON_SECRET=
CALENDAR_FEED_TOKEN=

# Your deployed URL (used to build the calendar feed link shown in Settings)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The single user this deployment serves (v1 is single-tenant)
APP_USER_EMAIL=you@example.com
