# Portlander — copy to .env.local (never commit secrets)
# Restart `npm run dev` after changing env vars.

# Supabase (optional — app stays in local/demo mode when empty)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Finnhub — used ONLY by:
#   - npm run sync:events          (local, recommended now)
#   - supabase/functions/sync-events (Edge, later / cloud)
# Never put Finnhub keys in VITE_* (would expose them in the browser).
FINNHUB_API_KEY=

# Edge / server only when deploying sync-events to Supabase
# SUPABASE_SERVICE_ROLE_KEY=

# SnapTrade — Supabase Edge secrets only, never VITE_* (server-side signing).
# Set via the Supabase dashboard, not this file.
# SNAPTRADE_CLIENT_ID=
# SNAPTRADE_CONSUMER_KEY=
#
# Which SnapTrade customer model the keys belong to. Defaults to 'personal'.
# Set to 'commercial' only for a Commercial API Key, which registers a separate
# SnapTrade user per Portlander user. See supabase/functions/snaptrade-connect/README.md.
# SNAPTRADE_AUTH_MODE=personal
#
# Personal mode only, and only once this project has more than one auth user:
# the Supabase user id that owns the SnapTrade key. With a single user it is
# resolved automatically and this can stay unset.
# SNAPTRADE_OWNER_USER_ID=
